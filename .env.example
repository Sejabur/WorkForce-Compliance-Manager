# Supabase Credentials (Optional for production cloud DB, falls back to client storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq API Key (Required for AI Risk Assessment briefings)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default Admin Passcode (Defaults to admin123 if not set)
NEXT_PUBLIC_ADMIN_PASSCODE=admin123
